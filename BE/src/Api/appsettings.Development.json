{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=scada_tlhn;Username=postgres;Password=123456;Include Error Detail=true",
    "Redis": "localhost:6379"
  },
  "Database": {
    "ApplyEfMigrations": false
  },
  "ConcurrentSession": {
    "DefaultMaxConcurrentUsers": 10,
    "ReservedAdminSlots": 1,
    "SessionTtlSeconds": 0,
    "RedisKeyPrefix": "tln:concurrent"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:5174",
      "http://localhost:4200",
      "http://127.0.0.1:3000",
      "http://127.0.0.1:5173",
      "http://127.0.0.1:5174",
      "http://127.0.0.1:4200"
    ]
  },
  "Jwt": {
    "Issuer": "Backend.Api",
    "Audience": "Backend.Client",
    "SigningKey": "DEV_ONLY_TLN_API_JWT_SIGNING_KEY_AT_LEAST_32_CHARS_LONG!",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "PasswordHashing": {
    "Algorithm": "Argon2id",
    "MemorySize": 65536,
    "Iterations": 3,
    "DegreeOfParallelism": 4,
    "HashLength": 32,
    "SaltLength": 16
  },
  "Auth": {
    "DefaultRegisterRole": "Operator",
    "PasswordResetTokenExpirationMinutes": 30
  },
  "Login": {
    "MaxFailed": 5,
    "WindowMinutes": 5,
    "LockMinutes": 15,
    "RedisKeyPrefix": "tln:auth:login-failed",
    "RateLimitEnabled": true,
    "RateLimitPermitPerWindow": 10,
    "RateLimitWindowSeconds": 60
  },
  "Realtime": {
    "Provider": "Redis",
    "RedisKeyPrefix": "scada:rt",
    "SimulateChanges": true,
    "SimulateIntervalSeconds": 1,
    "SeedExcelOnStartup": true,
    "ExcelPath": "data/Dinh_Nghia_Tag_Thuy_Loi_Ha_Noi.xlsx"
  }
}
